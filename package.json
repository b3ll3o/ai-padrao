{
  "name": "ai-padrao",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo blueprint: Next.js + NestJS + Postgres, SDD-driven.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "db:migrate": "docker compose exec api pnpm --filter @ai-padrao/api prisma:migrate-dev",
    "db:seed": "docker compose exec api pnpm --filter @ai-padrao/api prisma:seed",
    "db:reset": "docker compose exec api pnpm --filter @ai-padrao/api prisma migrate reset --force",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "harness:check": "bash .harness/check.sh",
    "harness:detect": "bash .harness/detect.sh",
    "harness:digest": "python3 .harness/digest.py",
    "harness:apply": "bash .harness/apply.sh",
    "harness:codemod": "bash .harness/codemods/run.sh",
    "harness:test": "python3 .harness/codemods/tests/test_codemods.py",
    "prebuild": "bash .harness/check.sh",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.9.6",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ]
  }
}
