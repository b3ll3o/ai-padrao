{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "test",
        "chore",
        "ci",
        "perf",
        "build",
        "revert"
      ]
    ],
    "scope-enum": [
      2,
      "always",
      [
        "root",
        "api",
        "web",
        "contracts",
        "db",
        "ui",
        "config",
        "docker",
        "sdd",
        "deps"
      ]
    ]
  }
}
