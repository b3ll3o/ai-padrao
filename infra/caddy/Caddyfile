{$DOMAIN} {
    encode gzip zstd
    # Block requests for sensitive paths at the proxy layer.
    # Returns 404 instead of leaking that the files exist.
    @blocked path /.env /.git/* /admin/* /.dockerignore /.openspec/* /Dockerfile*
    respond @blocked 404

    reverse_proxy /api/* api:3001
    reverse_proxy web:3000
}

# BEGIN MAIL BLOCK — included in the rendered config only when
# MAILHOG_SUBDOMAIN=true. The entrypoint script strips this block when the
# flag is anything else (default: false). This prevents Caddy from trying to
# obtain a Let's Encrypt cert for mail.{$DOMAIN} when no mail A record exists.
mail.{$DOMAIN} {
    reverse_proxy mailhog:8025
}
# END MAIL BLOCK