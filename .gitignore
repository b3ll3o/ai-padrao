dist/
.next/
.turbo/
*.tsbuildinfo

# env
.env
.env.local
.env.*.local
!.env.example

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# os
.DS_Store
Thumbs.db

# editor (project-config is committed; user-specific caches are not)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# coverage
coverage/

# prisma
apps/api/prisma/migrations/dev.db*

# python bytecode
__pycache__/

# agent runtime state (NOT policy — see .agents/)
# Claude Code writes worktrees/ and scheduled_tasks.json under .claude/;
# we no longer keep .claude/ in the repo, so these don't apply. Listed
# here in case a contributor's local .claude/ shows up in git status
# before they realise the policy.
.claude/worktrees/
.claude/scheduled_tasks.json
infra/.env.production
infra/data/

# Local SSH keys for testing deploys
*.pem
