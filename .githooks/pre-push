#!/usr/bin/env bash
# .githooks/pre-push — local pre-push gate. Blocks `git push` until the
# repository passes lint + typecheck + test. Pairs with CI for defense in
# depth (this hook is the local layer, CI is the remote layer).
#
# Steps (each must pass; the hook fails the push on the first failure
# and prints which step failed):
#
#   1. pnpm lint       (turbo — ESLint across all workspaces)
#   2. pnpm typecheck  (turbo — tsc --noEmit across all workspaces)
#   3. pnpm test       (turbo — unit + integration across all workspaces)
#
# Bypass paths:
#   git push --no-verify                      # bypass this hook for one push
#   git config --local --unset core.hooksPath # disable all hooks
#
# This script depends ONLY on bash + git + pnpm. No jq, no python.

set -uo pipefail

# ---- pre-push stdin contract ------------------------------------------
# git invokes this hook with one line per ref on stdin, in the form:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# We must read stdin even when we don't use the ref info, otherwise
# git can block waiting for us.
PUSH_REFS=()
while read -r local_ref local_sha remote_ref remote_sha; do
  PUSH_REFS+=("$local_ref $local_sha $remote_ref $remote_sha")
done
if [[ ${#PUSH_REFS[@]} -eq 0 ]]; then
  # No refs being pushed (e.g. push --all with nothing to send).
  exit 0
fi

# ---- resolve repo root -------------------------------------------------
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$ROOT" ]]; then
  echo "[pre-push] not inside a git repository" >&2
  exit 1
fi
cd "$ROOT"

# ---- toolchain check ---------------------------------------------------
for tool in git pnpm; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "[pre-push] '$tool' is not on PATH." >&2
    echo "[pre-push] Fix: install $tool, or disable via: git config --local --unset core.hooksPath" >&2
    exit 1
  fi
done

# ---- run steps ---------------------------------------------------------
STEP=0
FAIL_STEP=""

run_step() {
  STEP=$((STEP + 1))
  local label="$1"; shift
  echo "[pre-push] step ${STEP}: ${label}" >&2
  if ! "$@"; then
    FAIL_STEP="${label}"
    echo "[pre-push] FAIL at step ${STEP}: ${label}" >&2
    return 1
  fi
  return 0
}

START_TS="$(date +%s)"

run_step "pnpm lint"      pnpm lint      || exit 1
run_step "pnpm typecheck" pnpm typecheck || exit 1
run_step "pnpm test"      pnpm test      || exit 1

END_TS="$(date +%s)"
ELAPSED=$((END_TS - START_TS))
echo "[pre-push] OK in ${ELAPSED}s (${STEP} steps)"
exit 0
