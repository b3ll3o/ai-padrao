import { describe, it, expect } from "vitest";
import { <Entity> } from "<entity>";

describe("<Entity>", () => {
  describe("build()", () => {
    it("rejeita primitive props inválidas", () => {
      expect(() => <Entity>.build({ /* inválido */ } as any)).toThrow();
    });

    it("aceita primitive props válidas", () => {
      const entity = <Entity>.build({
        id: "id-1",
        // ...fields válidos
        createdAt: new Date(),
        updatedAt: new Date(),
        version: 0,
      });
      expect(entity.id).toBe("id-1");
    });
  });

  describe("rename()", () => {
    it("retorna uma nova instância com o field atualizado", () => {
      const entity = <Entity>.build({ /* válido */ });
      const next = /* novo ValueObject */;
      const renamed = entity.rename(next);
      expect(renamed).not.toBe(entity);
      expect(renamed.<field>).toBe(next);
    });

    it("retorna a mesma instância se nada muda", () => {
      const entity = <Entity>.build({ /* válido */ });
      const same = entity.rename(entity.<field>);
      expect(same).toBe(entity);
    });
  });

  describe("toJSON()", () => {
    it("serializa para o shape do DTO", () => {
      const entity = <Entity>.build({ /* válido */ });
      const json = entity.toJSON();
      expect(json).toMatchObject({ id: entity.id /* ... */ });
    });
  });
});
