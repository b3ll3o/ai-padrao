// Template: Value Object (imutável, auto-validável)
// Referência (exemplo vivo): apps/api/src/contexts/users/domain/value-objects/email.ts
//
// Convenção ai-padrao:
// - Construtor privado + factory estático `create()` que valida
// - Imutável: sem setters, sem mutação interna
// - Método `equals()` para comparação
// - Getter `value` para extrair o primitivo
// - Lança em violação de invariante

export class <ValueObject> {
  private constructor(private readonly _value: string) {}

  static create(raw: string): <ValueObject> {
    // Valida AQUI (lança em violação)
    if (raw.trim().length === 0) {
      throw new Error("<ValueObject> não pode ser vazio");
    }
    return new <ValueObject>(raw.trim());
  }

  get value(): string {
    return this._value;
  }

  equals(other: <ValueObject>): boolean {
    return this._value === other._value;
  }

  toString(): string {
    return this._value;
  }
}
