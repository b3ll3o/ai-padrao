// Template: Prisma Mapper (Prisma Record <-> Domain Entity)
// Referência (exemplo vivo): apps/api/src/contexts/users/infrastructure/persistence/prisma/user.mapper.ts
//
// Convenção ai-padrao:
// - Apenas métodos estáticos, sem estado de instância
// - Bidirecional: toDomain(prisma) e toPrisma(entity)
// - Mapper NÃO importa a port — só a entity
// - Teste de roundtrip obrigatório: toDomain(toPrisma(x)) deep-equals x

import { <Entity> } from "../../../domain/entities/<entity>";

type <Entity>Record = {
  id: string;
  // ...todos os primitive fields de schema.prisma
  createdAt: Date;
  updatedAt: Date;
  version: number;
};

export class <Entity>Mapper {
  static toDomain(record: <Entity>Record): <Entity> {
    return <Entity>.build({
      id: record.id,
      // ...mapeia fields, convertendo strings para ValueObjects
      createdAt: record.createdAt,
      updatedAt: record.updatedAt,
      version: record.version,
    });
  }

  static toPrisma(entity: <Entity>): <Entity>Record {
    return {
      id: entity.id,
      // ...mapeia fields, convertendo ValueObjects de volta para primitives
      createdAt: entity.createdAt,
      updatedAt: entity.updatedAt,
      version: entity.version,
    };
  }
}
