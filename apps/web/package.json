{
  "name": "@ai-padrao/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "VITE_CJS_IGNORE_WARNING=true vitest run",
    "test:integration": "VITE_CJS_IGNORE_WARNING=true vitest run --config ./vitest.integration.config.ts",
    "test:e2e": "node ./test/e2e-placeholder.mjs",
    "test:coverage": "VITE_CJS_IGNORE_WARNING=true vitest run --coverage",
    "test:all": "pnpm test && pnpm test:integration && pnpm test:e2e"
  },
  "dependencies": {
    "@ai-padrao/config-tailwind": "workspace:*",
    "@ai-padrao/contracts": "workspace:*",
    "@ai-padrao/ui": "workspace:*",
    "@hookform/resolvers": "^3.9.0",
    "@tanstack/react-query": "^5.59.16",
    "ky": "^1.7.2",
    "next": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.1",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ai-padrao/config-eslint": "workspace:*",
    "@ai-padrao/config-tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.0",
    "happy-dom": "^15.10.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.4"
  }
}
